      "title": "Minimal dua identitas",
      "points": [
        "Nama lengkap dan tanggal lahir/barcode dapat digunakan sesuai regulasi.",
        "Nomor kamar bukan identitas."
      ]
    },
    {
      "title": "Penandaan risiko",
      "points": [
        "Gelang alergi, jatuh, DNR, atau kondisi khusus adalah lapisan tambahan."
      ]
    }
  ],
  "do": [
    "Tanyakan dan cocokkan dua identitas.",
    "Label spesimen setelah verifikasi di dekat pasien."
  ],
  "dont": [
    "Menggunakan nomor kamar.",
    "Hanya mengenali wajah pasien."
  ],
  "quiz": [
    {
      "q": "Yang bukan identitas pasien adalah…",
